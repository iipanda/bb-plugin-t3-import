    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.13.12",
    "typescript": "^5.7.0"
  }
}
