{
  "name": "bb-plugin-t3-import",
  "version": "0.1.0",
  "description": "Import T3 Code threads into bb and pick up each conversation where you left off.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iipanda/bb-plugin-t3-import.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "build": "bb plugin build",
    "check-events": "node scripts/check-events.mjs"
  },
  "engines": {
    "bb": ">=0.45 <0.46",
    "bbPluginSdk": ">=0.6.15"
